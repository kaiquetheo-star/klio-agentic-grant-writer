# Open Agent Hackathon 2026 — Reasoning Engine (placeholders only)
# Copy values into backend/.env or infra/.env — never commit real secrets.

ZETARIS_API_KEY=your-key-here
ZETARIS_BASE_URL=https://api.enterprise.zetaris.com
ZETARIS_ORG_ID=your-org-id
ZETARIS_GRANTS_TABLE=grants
ZETARIS_QUERY_PATH=/api/v1.0/sql-editor/sqls/run-query
ZETARIS_QUERY_MODE=run_query
ZETARIS_TIMEOUT_SECONDS=30
ZETARIS_MAX_ATTEMPTS=2

METERLESS_BASE_URL=http://127.0.0.1:8088
METERLESS_RUNTIME_TOKEN=your-token-here
METERLESS_MARKOVIAN_PATH=/api/v1/engines/markovian/run
METERLESS_TIMEOUT_SECONDS=60
METERLESS_STEP_TIMEOUT_SECONDS=90
METERLESS_MAX_ATTEMPTS=2
METERLESS_APP_ID=klio-reasoning-engine

NVIDIA_API_KEY=your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-4-340b-instruct
NVIDIA_TIMEOUT_SECONDS=30
NVIDIA_MAX_ATTEMPTS=2
REASONING_ENGINE_TARGET_SCORE=8.0

# Judges without sponsor keys: SAMPLE_MODE=true runs synthetic isolated data.
# Does NOT write fake editais into the production radar database.
SAMPLE_MODE=false

# Gate: when false, /api/reasoning_engine/* routes are not mounted.
REASONING_ENGINE_ENABLED=true

# Optional tuning
REASONING_ENGINE_MAX_REVISIONS=3
REASONING_ENGINE_TIMEOUT_SECONDS=60

# Persistent project memory (local). Never put email/CPF/phone in owner_key.
# SAMPLE_MODE defaults to in-process memory; use django + sqlite:///tmp/... for durable local.
REASONING_ENGINE_MEMORY_BACKEND=memory
REASONING_ENGINE_MEMORY_MAX_CHARS=1200
# Do NOT enable remote H-MEM until an official Meterless contract exists.
METERLESS_HMEM_ENABLED=false
